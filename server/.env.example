# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Optional: defaults to MongoMemoryServer / persistent store if omitted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mealify?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=mealify_ultra_secure_jwt_secret_key_2026_neo_future
